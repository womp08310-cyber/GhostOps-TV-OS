<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ghostops_bg">

    <!-- Ambient Background Backdrop (Faded behind hero) -->
    <ImageView
        android:id="@+id/imgAmbientBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.25" />

    <!-- Top Status Bar -->
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentTop="true"
        android:paddingStart="48dp"
        android:paddingEnd="48dp"
        android:gravity="center_vertical"
        android:elevation="10dp">

        <!-- Logo & Brand Header -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_ghostops_logo"
                android:contentDescription="GhostOps Logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="GHOSTOPS"
                android:textColor="@color/ghostops_text_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:letterSpacing="0.15" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="TV"
                android:textColor="@color/ghostops_blue"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- System Clock & Date -->
            <TextView
                android:id="@+id/txtClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:text="10:24 AM"
                android:textColor="@color/ghostops_text_secondary"
                android:textSize="14sp"
                android:fontFamily="sans-serif-light" />

            <TextView
                android:id="@+id/txtDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="• Sat, Oct 24"
                android:textColor="@color/ghostops_text_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Right System Pills (Inputs, Wi-Fi, Settings) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Inputs Pill -->
            <TextView
                android:id="@+id/btnInputs"
                style="@style/PillButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Inputs (HDMI)" />

            <!-- Wi-Fi Pill -->
            <TextView
                android:id="@+id/btnWifi"
                style="@style/PillButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Wi-Fi: Connected" />

            <!-- Settings Pill -->
            <TextView
                android:id="@+id/btnSettings"
                style="@style/PillButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Settings" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Main Scrollable TV Experience -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/mainScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topBar"
        android:clipToPadding="false"
        android:paddingBottom="60dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="48dp"
            android:paddingEnd="48dp">

            <!-- Hero Spotlight Banner -->
            <RelativeLayout
                android:id="@+id/heroSpotlight"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="24dp">

                <!-- Hero Backdrop -->
                <ImageView
                    android:id="@+id/imgHeroBackdrop"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:background="#131826" />

                <!-- Left Dark Gradient Overlay for text contrast -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_hero_gradient" />

                <!-- Hero Details -->
                <LinearLayout
                    android:layout_width="540dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:paddingStart="32dp"
                    android:paddingEnd="16dp">

                    <TextView
                        android:id="@+id/txtHeroBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_tag_badge"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:text="★ #1 TRENDING 4K CINEMA"
                        android:textColor="#38bdf8"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1" />

                    <TextView
                        android:id="@+id/txtHeroTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Interstellar"
                        android:textColor="@color/ghostops_text_primary"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/txtHeroMeta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="2014 • 2h 49m • Sci-Fi / Adventure • 8.7 ★"
                        android:textColor="@color/ghostops_text_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtHeroOverview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:maxLines="3"
                        android:ellipsize="end"
                        android:text="A team of explorers travel through a wormhole in space in an attempt to ensure humanity's survival."
                        android:textColor="@color/ghostops_text_muted"
                        android:textSize="12sp" />

                    <!-- Primary Action Button: Watch in 4K -->
                    <TextView
                        android:id="@+id/btnHeroWatch"
                        style="@style/PillButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/selector_pill"
                        android:paddingStart="24dp"
                        android:paddingEnd="24dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:text="▶  Watch Now in 4K"
                        android:textSize="13sp" />
                </LinearLayout>
            </RelativeLayout>

            <!-- Rail 1: Trending Now -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_trending"
                android:textColor="@color/ghostops_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTrending"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:nestedScrollingEnabled="false" />

            <!-- Rail 2: Critically Acclaimed Masterpieces -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/section_masterpieces"
                android:textColor="@color/ghostops_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvMasterpieces"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:nestedScrollingEnabled="false" />

            <!-- Rail 3: Anime Universe -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/section_anime"
                android:textColor="@color/ghostops_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAnime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:nestedScrollingEnabled="false" />

            <!-- Rail 4: Installed TV Apps Dock -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/section_apps"
                android:textColor="@color/ghostops_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvApps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</RelativeLayout>
